# Required for Prisma and npm run test:auth:db to connect to PostgreSQL.
DATABASE_URL=
APP_ENV=development
APP_URL=http://localhost:3000

# Required in production. Development falls back to a local-only default if unset.
SESSION_SECRET=

# Verification code dev mode
DEV_AUTH_DEBUG_CODE=true
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_COOLDOWN_SECONDS=60
AUTH_SESSION_TTL_DAYS=7

# Credits and pricing
SIGNUP_BONUS_CREDITS=20
TEXT_TO_IMAGE_COST=10
IMAGE_TO_IMAGE_COST=15

# Image backend
# IMAGE_BACKEND supports official and relay.
# Keep the real API key only in private env files such as .env.local or server env vars.
# IMAGE_BASE_URL can be the relay root or the full /images/generations endpoint.
# Use placeholders in public templates. Do not commit real credentials.
IMAGE_BACKEND=official
IMAGE_API_KEY=custom_APIKEY
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
