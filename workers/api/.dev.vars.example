# Copy this file to workers/api/.dev.vars for local wrangler dev.
SESSION_SECRET=sparkpost-workers-dev-secret
DEV_AUTH_DEBUG_CODE=true
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_COOLDOWN_SECONDS=60
AUTH_VERIFY_CODE_MAX_ATTEMPTS=5
AUTH_VERIFY_CODE_LOCKOUT_SECONDS=900
AUTH_SESSION_TTL_DAYS=7
SIGNUP_BONUS_CREDITS=20
ALLOWED_ORIGINS=https://776607.xyz,https://www.776607.xyz,https://sparkpost.pages.dev,http://localhost:3000,http://127.0.0.1:3000
IMAGE_BACKEND=official
IMAGE_MODEL=dall-e-3
IMAGE_DEFAULT_MODEL_ID=nano-banana-2
OPENAI_IMAGE_API_KEY=replace_me_for_official_image_generation
RELAY_IMAGE_API_KEY=replace_me_for_relay_image_generation
RELAY_IMAGE_API_KEY_MICU=replace_me_for_micu_relay_image_generation
RELAY_IMAGE_BASE_URL_MICU=https://your-micu-relay.example.com/v1
# IMAGE_RELAY_BASE_URL_MICU and RELAY_IMAGE_BASE_URL are kept as legacy base URL fallbacks for the micu relay.
PROMPT_IDEA_PROVIDER=deepseek
PROMPT_IDEA_MODEL=deepseek-chat
PROMPT_EXPAND_PROVIDER=minimax
PROMPT_EXPAND_MODEL=MiniMax-Text-01
DEEPSEEK_API_KEY=replace_me_for_deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MINIMAX_API_KEY=replace_me_for_minimax
MINIMAX_BASE_URL=https://your-minimax-compatible.example.com/v1
OPENAI_API_KEY=replace_me_for_openai_text
OPENAI_BASE_URL=https://api.openai.com/v1
EMAIL_PROVIDER=resend
EMAIL_FROM=SparkPost <no-reply@example.com>
EMAIL_SUBJECT_PREFIX=[SparkPost]
RESEND_API_KEY=replace_me_for_email_delivery
